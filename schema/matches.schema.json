{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matches.schema.json",
  "title": "data/matches.json — 客観的な試合事実",
  "$comment": "推奨/VALUE判定・推定勝率・EV・オッズ・選択など分析判断は入れない（additionalProperties:false と integrity の禁止キー検査で二重に防ぐ）。",
  "type": "object",
  "required": ["schema_version", "matches"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "meta": { "$ref": "defs.schema.json#/$defs/fileMeta" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sport", "competition", "home", "away", "start_at", "start_time_status", "status", "result"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/id" },
          "sport": { "type": "string", "minLength": 1 },
          "competition": { "$ref": "defs.schema.json#/$defs/stringOrNull" },
          "home": { "type": "string", "minLength": 1 },
          "away": { "type": "string", "minLength": 1 },
          "venue": { "$ref": "defs.schema.json#/$defs/stringOrNull" },
          "start_at": { "$ref": "defs.schema.json#/$defs/dateTimeOrNull" },
          "start_time_status": {
            "enum": ["recorded", "unverified", "unknown"],
            "description": "recorded=記録どおりの開始時刻 / unverified=候補はあるが未確認（start_at は null） / unknown=不明（start_at は null）"
          },
          "start_time_note": { "$ref": "defs.schema.json#/$defs/stringOrNull" },
          "status": {
            "enum": ["scheduled", "live", "final", "cancelled", "postponed", "abandoned", "unknown"],
            "description": "unknown=開始時刻を過ぎた、または開始時刻不明で結果が未記録"
          },
          "result": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "final": { "$ref": "defs.schema.json#/$defs/score" },
              "periods": {
                "type": "object",
                "description": "ht=前半, set1=第1セット, map1=第1マップ など",
                "additionalProperties": { "$ref": "defs.schema.json#/$defs/score" }
              },
              "winners": {
                "type": "object",
                "description": "スコアは不明だが勝者だけ記録がある場合（キーは final / ht / set1 / map1 など）",
                "additionalProperties": { "$ref": "defs.schema.json#/$defs/side" }
              },
              "text": { "$ref": "defs.schema.json#/$defs/stringOrNull" }
            }
          },
          "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "verified_at": { "$ref": "defs.schema.json#/$defs/dateTimeOrNull" },
          "flags": { "$ref": "defs.schema.json#/$defs/flags" },
          "note": { "$ref": "defs.schema.json#/$defs/stringOrNull" }
        }
      }
    }
  }
}
