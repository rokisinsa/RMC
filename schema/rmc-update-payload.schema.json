{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rmc-update-payload.schema.json",
  "title": "RMC 定時更新 payload（外部の分析側 → GitHub の本番更新 workflow）",
  "$comment": "GitHub 側は分析しない。外部（ChatGPT など）が作った更新内容を、この形で受け取り、検査して data/ へ反映するだけ。系統ごとに別のブロックで受け取り、共通の候補プールは持たない。既存カードへの操作は「追記してよい項目」だけ（pick_updates / append_snapshots / bets）。",
  "type": "object",
  "required": [
    "payload_version",
    "run_id",
    "source",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "payload_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,80}$",
      "description": "この定時更新の ID（例 rmc-2026-09-27-0600）"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "更新を作った主体（例 ChatGPT Automations 06:00）"
    },
    "generated_at": {
      "$ref": "defs.schema.json#/$defs/dateTime",
      "description": "payload を作り終えた時刻（JST）。これより後の時刻の情報は入れられない"
    },
    "slot": {
      "enum": [
        "06:00",
        "12:00",
        "18:00",
        "23:00",
        "adhoc"
      ]
    },
    "note": {
      "$ref": "defs.schema.json#/$defs/stringOrNull"
    },
    "matches": {
      "type": "object",
      "required": [
        "update_run",
        "new"
      ],
      "additionalProperties": false,
      "description": "□3〜□6 で使う新しい試合の登録（試合事実だけ）",
      "properties": {
        "update_run": {
          "$ref": "matches.schema.json#/properties/update_runs/items"
        },
        "new": {
          "type": "array",
          "items": {
            "$ref": "matches.schema.json#/properties/matches/items"
          }
        }
      }
    },
    "result_updates": {
      "type": "array",
      "description": "□1 結果更新（data/match-updates.json に更新回として追記）",
      "items": {
        "$ref": "match-updates.schema.json#/properties/runs/items"
      }
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "description": "系統ごとに独立したブロック。ある系統のブロックに他系統のカードは入れられない",
      "properties": {
        "recommendations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discovery_runs": {
              "type": "array",
              "items": {
                "$ref": "recommendations.schema.json#/properties/discovery_runs/items"
              }
            },
            "new_picks": {
              "type": "array",
              "items": {
                "$ref": "recommendations.schema.json#/properties/picks/items"
              }
            },
            "pick_updates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/closingUpdate"
              }
            }
          }
        },
        "value1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discovery_runs": {
              "type": "array",
              "items": {
                "$ref": "value1.schema.json#/properties/discovery_runs/items"
              }
            },
            "new_picks": {
              "type": "array",
              "items": {
                "$ref": "value1.schema.json#/properties/picks/items"
              }
            },
            "pick_updates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value1Update"
              }
            }
          }
        },
        "value2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discovery_runs": {
              "type": "array",
              "items": {
                "$ref": "value2.schema.json#/properties/discovery_runs/items"
              }
            },
            "new_picks": {
              "type": "array",
              "items": {
                "$ref": "value2.schema.json#/properties/picks/items"
              }
            },
            "pick_updates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/closingUpdate"
              }
            }
          }
        },
        "experience": {
          "type": "object",
          "additionalProperties": false,
          "description": "経験値取引（分析系統ではない。探索回を持たない）",
          "properties": {
            "new_picks": {
              "type": "array",
              "items": {
                "$ref": "experience.schema.json#/properties/picks/items"
              }
            },
            "pick_updates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/closingUpdate"
              }
            }
          }
        },
        "pro_edge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "discovery_runs": {
              "type": "array",
              "items": {
                "$ref": "pro_edge.schema.json#/properties/discovery_runs/items"
              }
            },
            "new_picks": {
              "type": "array",
              "items": {
                "$ref": "pro_edge.schema.json#/$defs/pick"
              }
            },
            "append_snapshots": {
              "type": "array",
              "description": "既存の④カードへの価格スナップショットの追記（締切オッズなど）",
              "items": {
                "type": "object",
                "required": [
                  "pick_id",
                  "snapshot"
                ],
                "additionalProperties": false,
                "properties": {
                  "pick_id": {
                    "type": "string",
                    "pattern": "^pe-"
                  },
                  "snapshot": {
                    "$ref": "pro_edge.schema.json#/$defs/snapshot"
                  }
                }
              }
            },
            "bets": {
              "type": "array",
              "description": "既存の④カードの購入記録（bet_odds が未記録のときだけ）",
              "items": {
                "type": "object",
                "required": [
                  "pick_id",
                  "bet_odds",
                  "bet_bookmaker",
                  "bet_at"
                ],
                "additionalProperties": false,
                "properties": {
                  "pick_id": {
                    "type": "string",
                    "pattern": "^pe-"
                  },
                  "bet_odds": {
                    "type": "number",
                    "exclusiveMinimum": 1
                  },
                  "bet_bookmaker": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bet_at": {
                    "$ref": "defs.schema.json#/$defs/dateTime"
                  }
                }
              }
            },
            "reported": {
              "type": "array",
              "description": "外部の分析側が計算した④の値（照合用。保存はしない。GitHub 側で入力から再計算し、食い違えば拒否）",
              "items": {
                "$ref": "#/$defs/proEdgeReported"
              }
            }
          }
        }
      }
    },
    "post_match_reviews": {
      "type": "object",
      "additionalProperties": false,
      "description": "□8 試合後レビュー（系統ごとのファイルに追記）",
      "properties": {
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "post-match-review.schema.json#/properties/reviews/items"
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "$ref": "post-match-review.schema.json#/properties/reviews/items"
          }
        },
        "value1": {
          "type": "array",
          "items": {
            "$ref": "post-match-review.schema.json#/properties/reviews/items"
          }
        },
        "value2": {
          "type": "array",
          "items": {
            "$ref": "post-match-review.schema.json#/properties/reviews/items"
          }
        },
        "pro_edge": {
          "type": "array",
          "items": {
            "$ref": "post-match-review.schema.json#/properties/reviews/items"
          }
        }
      }
    },
    "coverage_audit": {
      "type": "object",
      "required": [
        "scope",
        "sportsbook_master",
        "systems"
      ],
      "additionalProperties": false,
      "description": "完全版更新の探索網羅性監査。定時スロットでは必須。未走査が1競技でもあれば本番反映を拒否する。",
      "properties": {
        "sportsbook_master": {
          "type": "object",
          "required": [
            "bet_channel",
            "union_sports",
            "source_audit"
          ],
          "additionalProperties": false,
          "properties": {
            "bet_channel": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "casitabi": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "yuugado": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "union_sports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "unavailable_sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "source_audit": {
              "type": "object",
              "required": [
                "bet_channel"
              ],
              "additionalProperties": false,
              "properties": {
                "bet_channel": {
                  "type": "object",
                  "required": [
                    "checked_at",
                    "source_urls",
                    "menu_end_verified",
                    "category_count",
                    "event_count",
                    "access_status",
                    "event_ids"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "checked_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "source_urls": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "menu_end_verified": {
                      "type": "boolean"
                    },
                    "category_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "event_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "access_status": {
                      "enum": [
                        "direct",
                        "public_fallback",
                        "partial",
                        "unavailable"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "event_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "description": "当該更新窓で実際に確認したサイト掲載イベントの一意ID"
                    }
                  }
                },
                "casitabi": {
                  "type": "object",
                  "required": [
                    "checked_at",
                    "source_urls",
                    "menu_end_verified",
                    "category_count",
                    "event_count",
                    "access_status",
                    "event_ids"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "checked_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "source_urls": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "menu_end_verified": {
                      "type": "boolean"
                    },
                    "category_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "event_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "access_status": {
                      "enum": [
                        "direct",
                        "public_fallback",
                        "partial",
                        "unavailable"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "event_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "description": "当該更新窓で実際に確認したサイト掲載イベントの一意ID"
                    }
                  }
                },
                "yuugado": {
                  "type": "object",
                  "required": [
                    "checked_at",
                    "source_urls",
                    "menu_end_verified",
                    "category_count",
                    "event_count",
                    "access_status",
                    "event_ids"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "checked_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "source_urls": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "menu_end_verified": {
                      "type": "boolean"
                    },
                    "category_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "event_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "access_status": {
                      "enum": [
                        "direct",
                        "public_fallback",
                        "partial",
                        "unavailable"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "event_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "description": "当該更新窓で実際に確認したサイト掲載イベントの一意ID"
                    }
                  }
                }
              }
            },
            "mode": {
              "enum": [
                "bet_channel_only",
                "three_site"
              ],
              "description": "bet_channel_onlyならBET CHANNELだけを完全性の母表にする。省略時は旧互換のthree_site扱い。"
            }
          }
        },
        "systems": {
          "type": "object",
          "required": [
            "recommendations",
            "value1",
            "value2",
            "pro_edge"
          ],
          "additionalProperties": false,
          "properties": {
            "recommendations": {
              "$ref": "#/$defs/coverageSystem"
            },
            "value1": {
              "$ref": "#/$defs/coverageSystem"
            },
            "value2": {
              "$ref": "#/$defs/coverageSystem"
            },
            "pro_edge": {
              "$ref": "#/$defs/coverageSystem"
            }
          }
        },
        "scope": {
          "enum": [
            "bet_channel_only",
            "all_three"
          ],
          "description": "今回の完全探索対象。bet_channel_only はBET CHANNELだけを完全母表にする。"
        }
      }
    }
  },
  "$defs": {
    "closingUpdate": {
      "type": "object",
      "required": [
        "pick_id",
        "closing_odds"
      ],
      "additionalProperties": false,
      "description": "締切オッズの追記（未記録のときだけ）。locked の事前値・odds_taken・stake は変更できない",
      "properties": {
        "pick_id": {
          "type": "string",
          "minLength": 2
        },
        "closing_odds": {
          "type": "number",
          "exclusiveMinimum": 1
        }
      }
    },
    "value1Update": {
      "type": "object",
      "required": [
        "pick_id"
      ],
      "additionalProperties": false,
      "description": "VALUE① の締切オッズ追記、または条件付きVALUE の条件確認（未確認のときだけ）",
      "properties": {
        "pick_id": {
          "type": "string",
          "pattern": "^v1-"
        },
        "closing_odds": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "condition": {
          "$ref": "defs.schema.json#/$defs/condition"
        }
      }
    },
    "proEdgeReported": {
      "type": "object",
      "required": [
        "pick_id"
      ],
      "additionalProperties": false,
      "properties": {
        "pick_id": {
          "type": "string",
          "pattern": "^pe-"
        },
        "market_probability": {
          "type": [
            "number",
            "null"
          ]
        },
        "base_probability": {
          "type": [
            "number",
            "null"
          ]
        },
        "expert_adjustment": {
          "type": [
            "number",
            "null"
          ]
        },
        "final_probability": {
          "type": [
            "number",
            "null"
          ]
        },
        "edge": {
          "type": [
            "number",
            "null"
          ]
        },
        "fair_odds": {
          "type": [
            "number",
            "null"
          ]
        },
        "ev": {
          "type": [
            "number",
            "null"
          ]
        },
        "required_ev": {
          "type": [
            "number",
            "null"
          ]
        },
        "minimum_entry_odds": {
          "type": [
            "number",
            "null"
          ]
        },
        "clv_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "clv_probability": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "coverageSystem": {
      "type": "object",
      "required": [
        "target_sports",
        "scanned_sports",
        "unscanned_sports",
        "cards_checked",
        "competitions_checked",
        "deep_dived",
        "accepted",
        "watch",
        "rejected",
        "card_ids",
        "sport_card_counts"
      ],
      "additionalProperties": false,
      "properties": {
        "target_sports": {
          "type": "integer",
          "minimum": 1
        },
        "scanned_sports": {
          "type": "integer",
          "minimum": 0
        },
        "unscanned_sports": {
          "type": "integer",
          "minimum": 0
        },
        "zero_card_sports": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_sports": {
          "type": "integer",
          "minimum": 0
        },
        "cards_checked": {
          "type": "integer",
          "minimum": 0
        },
        "competitions_checked": {
          "type": "integer",
          "minimum": 0
        },
        "deep_dived": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "watch": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "scanned_sport_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unscanned_sport_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "card_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "実際に一次確認したカードの一意ID。cards_checkedはこの配列長から検証する"
        },
        "sport_card_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "対象競技マスター全競技をキーに実カード件数を記録。0件も0として明示"
        }
      }
    }
  }
}
