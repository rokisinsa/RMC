{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "title": "RMC 共通定義",
  "$comment": "各系統のスキーマから参照する部品。日時はすべてタイムゾーン付きISO 8601。",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "description": "タイムゾーン付きISO 8601（例: 2026-09-26T21:00:00+09:00）"
    },
    "dateTimeOrNull": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "oddsOrNull": {
      "type": ["number", "null"],
      "exclusiveMinimum": 1,
      "description": "10進オッズ。1より大きい一点の値。"
    },
    "probOrNull": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "numberOrNull": {
      "type": ["number", "null"]
    },
    "stringOrNull": {
      "type": ["string", "null"]
    },
    "side": {
      "enum": ["home", "away", "draw"],
      "description": "matches.json の home/away を基準にした選択側。"
    },
    "market": {
      "enum": ["match_winner", "match_1x2", "dnb", "first_half_1x2", "set1_winner", "map1_winner", "other"],
      "description": "match_winner=引分なしの勝者 / match_1x2=90分1X2 / dnb=ドローノーベット / first_half_1x2=前半1X2 / set1_winner=第1セット / map1_winner=第1マップ / other=自動精算不可（settlement_overrideで精算）"
    },
    "score": {
      "type": "object",
      "required": ["home", "away"],
      "additionalProperties": false,
      "properties": {
        "home": { "type": "integer", "minimum": 0 },
        "away": { "type": "integer", "minimum": 0 }
      }
    },
    "marketOdds": {
      "type": ["object", "null"],
      "required": ["text"],
      "additionalProperties": false,
      "description": "確認できた市場オッズ。レンジしか分からない場合は min/max に入れ、一点へ固定しない。精算には使わない。",
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "min": { "$ref": "#/$defs/oddsOrNull" },
        "max": { "$ref": "#/$defs/oddsOrNull" },
        "observed_at": { "$ref": "#/$defs/dateTimeOrNull" },
        "source": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "settlementOverride": {
      "type": ["object", "null"],
      "required": ["state", "reason", "set_at"],
      "additionalProperties": false,
      "description": "試合事実から自動判定できない場合（ライブ市場・特殊市場・旧データ移行）だけ使う明示的な精算状態。",
      "properties": {
        "state": { "enum": ["win", "loss", "push", "void"] },
        "reason": { "type": "string", "minLength": 1 },
        "set_at": { "$ref": "#/$defs/dateTime" },
        "source": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["duplicate_review", "needs_review", "legacy_import", "time_unverified", "odds_unverified", "result_unverified"]
      }
    },
    "reevaluation": {
      "type": "object",
      "required": ["at", "model_version"],
      "additionalProperties": false,
      "description": "将来モデルによる参考再評価。locked の値は変更せず、ここへ追記だけする。",
      "properties": {
        "at": { "$ref": "#/$defs/dateTime" },
        "model_version": { "type": "string", "minLength": 1 },
        "prob": { "$ref": "#/$defs/probOrNull" },
        "note": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "condition": {
      "type": ["object", "null"],
      "required": ["text", "met", "checked_at"],
      "additionalProperties": false,
      "description": "VALUE①の条件付きVALUE専用。met=true かつ checked_at が試合開始前の場合だけ本成績へ算入。",
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "min_odds": { "$ref": "#/$defs/oddsOrNull" },
        "met": { "type": ["boolean", "null"] },
        "checked_at": { "$ref": "#/$defs/dateTimeOrNull" }
      }
    },
    "discoveryRun": {
      "type": "object",
      "required": ["run_id", "started_at", "slot"],
      "additionalProperties": false,
      "description": "その系統が単独で行った新規候補探索1回分。系統をまたいで共有しない。",
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "started_at": { "$ref": "#/$defs/dateTime" },
        "slot": { "enum": ["06:00", "12:00", "18:00", "23:00", "adhoc"] },
        "note": { "$ref": "#/$defs/stringOrNull" }
      }
    },
    "pickBase": {
      "type": "object",
      "required": [
        "id", "system", "match_id", "market", "selection",
        "market_odds", "odds_taken", "stake",
        "discovered_at", "bet_at", "locked_at",
        "locked", "settlement_override", "flags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "system": { "enum": ["recommendations", "experience", "value1", "value2"] },
        "match_id": { "$ref": "#/$defs/id" },
        "market": { "$ref": "#/$defs/market" },
        "market_label": { "$ref": "#/$defs/stringOrNull" },
        "selection": { "$ref": "#/$defs/side" },
        "selection_label": { "$ref": "#/$defs/stringOrNull" },
        "market_odds": { "$ref": "#/$defs/marketOdds" },
        "odds_taken": { "$ref": "#/$defs/oddsOrNull" },
        "stake": { "type": ["number", "null"], "minimum": 0 },
        "discovered_at": { "$ref": "#/$defs/dateTimeOrNull" },
        "run_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "bet_at": { "$ref": "#/$defs/dateTimeOrNull" },
        "locked_at": { "$ref": "#/$defs/dateTimeOrNull" },
        "live": { "type": "boolean" },
        "locked": { "type": ["object", "null"] },
        "condition": { "$ref": "#/$defs/condition" },
        "closing_odds": { "$ref": "#/$defs/oddsOrNull" },
        "reevaluations": { "type": "array", "items": { "$ref": "#/$defs/reevaluation" } },
        "settlement_override": { "$ref": "#/$defs/settlementOverride" },
        "flags": { "$ref": "#/$defs/flags" },
        "detail_ref": { "$ref": "#/$defs/stringOrNull" },
        "note": { "$ref": "#/$defs/stringOrNull" }
      }
    }
  }
}
